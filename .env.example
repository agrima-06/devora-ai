# ==============================================================================
# Devora AI — Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values.
# DO NOT COMMIT SENSITIVE KEYS OR PRODUCTION PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Devora AI"
VERSION="0.1.0"
ENVIRONMENT="production"                        # development | staging | production
LOG_LEVEL="INFO"                               # DEBUG | INFO | WARNING | ERROR
SHOWCASE_MODE="true"                           # Set to 'true' to enable public showcase safety guards

# --- Security & Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"             # 24 hours

# --- Database & Storage (PostgreSQL 16 + pgvector) ---
# Supported formats: postgresql+asyncpg://user:pass@host:port/db
# (Standard postgres:// and postgresql:// URLs are automatically normalized)
DATABASE_URL="postgresql+asyncpg://postgres:your_secure_password@localhost:5432/devora?ssl=require"
DB_ECHO="false"
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"

# --- Redis Cache & Queue (Optional) ---
REDIS_URL="redis://localhost:6379/0"

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list or JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS="https://app.devora.ai,https://devora.vercel.app,http://localhost:3000"

# --- Google Gemini AI Model Gateway ---
# Required for live LLM reasoning and semantic vector embeddings
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION="768"
USE_MOCK_LLM="false"                           # Set to 'true' to use offline deterministic mock AI provider

# --- GitHub Integration ---
# Optional: Connects autonomous engineering workflows directly to GitHub repositories
GITHUB_TOKEN="ghp_yourPersonalAccessTokenHere"  # Fine-grained or Classic PAT fallback
GITHUB_APP_ID=""                               # Numeric GitHub App ID (optional)
GITHUB_APP_PRIVATE_KEY=""                      # Raw RSA private key or path to PEM file (optional)
DEVORA_MOCK_GITHUB="false"                     # Set to 'true' to simulate GitHub API responses

# --- Workspace & Sandbox Configuration ---
WORKSPACE_BASE_DIR="/tmp/devora/repos"
DEVORA_TASKS_DIR="/tmp/devora/tasks"
DEVORA_SANDBOX_RUNNER="docker"                 # docker | local | isolated_process
SANDBOX_CONTAINER_MEMORY_LIMIT="1500m"
SANDBOX_CONTAINER_CPU_LIMIT="2.0"
SANDBOX_CONTAINER_PIDS_LIMIT="100"

# --- Workflow Recovery & Reliability ---
RECOVERY_ENABLED="true"
RECOVERY_HEARTBEAT_TIMEOUT_SECONDS="120"
CIRCUIT_BREAKER_ENABLED="true"

# --- Frontend Environment Variables (Used by Next.js) ---
# Set this in your Vercel project or frontend container:
NEXT_PUBLIC_API_URL="https://api.devora.ai"     # Direct URL to the FastAPI backend API
